digraph dependencies {
    rankdir=LR;
    node [shape=box, style=rounded, fontname=Helvetica];
    "@babel/core" [style="rounded,filled", fillcolor=lightblue];
    "@babel/core" -> "@babel/code-frame";
    "@babel/core" -> "@babel/generator";
    "@babel/core" -> "@babel/helper-compilation-targets";
    "@babel/core" -> "@babel/helpers";
    "@babel/core" -> "@babel/parser";
    "@babel/core" -> "@babel/template";
    "@babel/core" -> "@babel/traverse";
    "@babel/core" -> "@babel/types";
    "@babel/core" -> "@types/gensync";
    "@babel/core" -> "convert-source-map";
    "@babel/core" -> "empathic";
    "@babel/core" -> "gensync";
    "@babel/core" -> "import-meta-resolve";
    "@babel/core" -> "json5";
    "@babel/core" -> "obug";
    "@babel/core" -> "verkit";
    "@babel/code-frame" -> "@babel/helper-validator-identifier";
    "@babel/code-frame" -> "js-tokens";
    "@babel/generator" -> "@babel/parser";
    "@babel/generator" -> "@babel/types";
    "@babel/generator" -> "@jridgewell/gen-mapping";
    "@babel/generator" -> "@jridgewell/trace-mapping";
    "@babel/generator" -> "@types/jsesc";
    "@babel/generator" -> "jsesc";
    "@babel/parser" -> "@babel/types";
    "@babel/types" -> "@babel/helper-string-parser";
    "@babel/types" -> "@babel/helper-validator-identifier";
    "@jridgewell/gen-mapping" -> "@jridgewell/sourcemap-codec";
    "@jridgewell/gen-mapping" -> "@jridgewell/trace-mapping";
    "@jridgewell/trace-mapping" -> "@jridgewell/resolve-uri";
    "@jridgewell/trace-mapping" -> "@jridgewell/sourcemap-codec";
    "@babel/helper-compilation-targets" -> "@babel/compat-data";
    "@babel/helper-compilation-targets" -> "@babel/helper-validator-option";
    "@babel/helper-compilation-targets" -> "browserslist";
    "@babel/helper-compilation-targets" -> "flru";
    "@babel/helper-compilation-targets" -> "verkit";
    "browserslist" -> "baseline-browser-mapping";
    "browserslist" -> "caniuse-lite";
    "browserslist" -> "electron-to-chromium";
    "browserslist" -> "node-releases";
    "browserslist" -> "update-browserslist-db";
    "update-browserslist-db" -> "escalade";
    "update-browserslist-db" -> "picocolors";
    "@babel/helpers" -> "@babel/template";
    "@babel/helpers" -> "@babel/types";
    "@babel/template" -> "@babel/code-frame";
    "@babel/template" -> "@babel/parser";
    "@babel/template" -> "@babel/types";
    "@babel/traverse" -> "@babel/code-frame";
    "@babel/traverse" -> "@babel/generator";
    "@babel/traverse" -> "@babel/helper-globals";
    "@babel/traverse" -> "@babel/parser";
    "@babel/traverse" -> "@babel/template";
    "@babel/traverse" -> "@babel/types";
    "@babel/traverse" -> "obug";
}
